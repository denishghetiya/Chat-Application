<h4>Welcome, @ViewBag.Username!</h4>

@{
    ViewBag.Title = "Real-Time Chat";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="row g-4">
        <!-- Left Column -->
        <div class="col-md-6">
            <!-- Search by Username -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <span>🔍 Search by Username</span>
                </div>
                <div class="card-body">
                    <input type="text" id="emailSearch" class="form-control mb-2" placeholder="Enter username..." />
                    <ul id="searchResults" class="list-group small"></ul>
                </div>
            </div>

            <!-- Search Friend List -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-success text-white">
                    👥 Search Friend List
                </div>
                <div class="card-body">
                    <input type="text" id="usernameSearch" class="form-control mb-2" placeholder="Search by username..." />
                    <ul id="friendList" class="list-group small"></ul>
                </div>
            </div>

            <!-- Pending Friend Requests -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-warning text-dark">
                    📨 Pending Friend Requests
                </div>
                <div class="card-body">
                    <ul id="pendingRequests" class="list-group small"></ul>
                </div>
            </div>
        </div>

        <!-- Right Column -->
        <div class="col-md-6">
            <!-- Create New Group -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-info text-white">
                    ➕ Create New Group
                </div>
                <div class="card-body text-center">
                    <button class="btn btn-info btn-lg px-4" type="button" data-bs-toggle="modal" data-bs-target="#createGroupModal">
                        Create Group
                    </button>
                </div>
            </div>

            <!-- My Groups -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-secondary text-white">
                    🗣️ My Groups
                </div>
                <div class="card-body">
                    <ul id="myGroupList" class="list-group small"></ul>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="createGroupModal" tabindex="-1" aria-labelledby="createGroupModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <!-- Wider for better view -->
        <div class="modal-content border-0 shadow-lg rounded-3">

            <!-- Modal Header -->
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-semibold" id="createGroupModalLabel">
                    <i class="bi bi-people-fill me-2"></i>Create New Group
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body">
                <!-- Group Name -->
                <div class="mb-4">
                    <label for="modalGroupName" class="form-label fw-semibold">
                        <i class="bi bi-pencil-square me-1"></i> Group Name
                    </label>
                    <input type="text" id="modalGroupName" class="form-control form-control-lg" placeholder="Enter group name" />
                </div>

                <!-- Members List -->
                <div>
                    <label for="groupMembersList" class="form-label fw-semibold">
                        <i class="bi bi-person-check me-1"></i> Select Members
                    </label>
                    <div id="groupMembersList" class="list-group border rounded" style="max-height: 250px; overflow-y: auto;">
                        <!-- Dynamically loaded members -->
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer bg-light border-top-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i> Cancel
                </button>
                <button type="button" class="btn btn-success" id="confirmCreateGroupBtn">
                    <i class="bi bi-check-circle me-1"></i> Create Group
                </button>
            </div>

        </div>
    </div>
</div>

<style>
    .list-group {
        max-height: 300px;
        overflow-y: auto;
    }

    #groupMembersList .list-group-item {
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

    #groupMembersList .list-group-item:hover {
        background-color: #f8f9fa;
    }
</style>

